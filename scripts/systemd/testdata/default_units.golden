##### macp-browser.service
[Unit]
Description=macp-browser logged-in Chrome (Xvfb :77, CDP 127.0.0.1:9277) at boot
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/neutral-home/.config/macp-browser/browser.sh

[Service]
Type=oneshot
WorkingDirectory=/srv/neutral-home/.config/macp-browser
EnvironmentFile=/srv/neutral-home/.config/macp/env
ExecStart=/bin/bash /srv/neutral-home/.config/macp-browser/browser.sh up
StandardOutput=append:/srv/neutral-vault/logs/macp-browser.out.log
StandardError=append:/srv/neutral-vault/logs/macp-browser.err.log
TimeoutStartSec=1800
RemainAfterExit=yes
ExecStop=/bin/bash /srv/neutral-home/.config/macp-browser/browser.sh stop
KillMode=process
# Chrome is stopped only via ExecStop (browser.sh stop, SIGTERM): setsid
# does not leave this cgroup, so KillMode=process + RemainAfterExit keep
# systemd from killing the logged-in profile on stop/restart.

[Install]
WantedBy=default.target
